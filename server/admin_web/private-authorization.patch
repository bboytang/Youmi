diff --git a/main/manager-web/src/apis/module/device.js b/main/manager-web/src/apis/module/device.js
--- a/main/manager-web/src/apis/module/device.js
+++ b/main/manager-web/src/apis/module/device.js
@@ -4,0 +5,14 @@
+    privateAuthorization(deviceId, action, callback, hardwareCode) {
+        const url = new URL(`${getServiceUrl()}/device/youmi-auth/${action}`, window.location.href);
+        if (window.location.protocol !== 'https:' || url.protocol !== 'https:' || url.origin !== window.location.origin
+            || !['code', 'revoke'].includes(action)) {
+            callback({ code: -1, msg: '请先通过 HTTPS 打开智控台，再办理私有授权。' });
+            return;
+        }
+        const body = { device_id: deviceId };
+        if (hardwareCode !== undefined) body.hardware_code = hardwareCode;
+        RequestService.sendRequest().sensitive().url(url.href).method('POST').data(body)
+            .success(res => callback(res.data))
+            .fail(() => callback({ code: -1, msg: '授权未完成，请检查当前设备权限。' }))
+            .networkFail(() => callback({ code: -1, msg: '授权请求未完成，请检查网络后手动重试。' })).send();
+    },
